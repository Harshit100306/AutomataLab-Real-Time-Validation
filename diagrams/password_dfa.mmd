flowchart TD
S([Start]) --> I["length=0; category mask=0000"]
I --> C{"Next character"}
C -->|lower| L["Set lowercase bit"]
C -->|upper| U["Set uppercase bit"]
C -->|digit| D["Set digit bit"]
C -->|allowed special| X["Set special bit"]
C -->|other| R[["Reject"]]
L --> N["Increment length"]; U --> N; D --> N; X --> N
N --> B{"length ≤ 20?"}
B -->|No| R
B -->|Yes| M{"More input?"}
M -->|Yes| C
M -->|No| A{"length ≥ 8 and mask=1111?"}
A -->|Yes| F((Accept)); A -->|No| R
